# StoryForge settings. Edit a value, save, then restart with: ./scripts/start.sh
# Lines starting with # are comments. Paths match the Jetson described in the brief.

# ---------- Story writer (Qwen through llama-server) ----------
LLM_URL=http://127.0.0.1:8080
# Words per page come from the story's reading level (chosen on the cover and /draw):
# Pre-reader 30-45, Early reader 45-60, Confident reader 60-80 (storyforge/llm.py, READING_LEVELS).
# Upper limit on tokens per page (story text + choices + notes). Keep well under -c 2048.
LLM_MAX_TOKENS=480
LLM_TEMPERATURE=0.8
LLM_TIMEOUT_SECONDS=180
# Most pages a single story may have.
MAX_SEGMENTS=40

# ---------- Illustrations (stable-diffusion.cpp) ----------
SD_CLI=/home/akw/jetson-ai/stable-diffusion.cpp/build/bin/sd-cli
SD_MODEL=/home/akw/jetson-ai/models/images/v1-5-pruned_Q4_0.gguf
IMAGE_DIR=/home/akw/jetson-ai/generated_images
SD_WIDTH=512
SD_HEIGHT=512
# 20 is the known-working value. 15 is usually close in quality and about 25% faster.
# Run ./scripts/benchmark_sd.sh and pick the lowest number whose pictures you still like.
SD_STEPS=15
# The flags from the known-working command. Change only after benchmarking.
SD_EXTRA_ARGS=--diffusion-fa --vae-tiling --backend te=cpu --max-vram 0
# These words are put at the START of every picture prompt.
SD_STYLE=children's storybook watercolor illustration, soft bright colors
SD_NEGATIVE=text, watermark, signature, blurry, deformed, extra limbs, scary, photo
SD_TIMEOUT_SECONDS=600
# Fast mode. After running ./scripts/get_fast_models.sh these two files exist and are used
# automatically: pictures need about 6 steps instead of 15. Set SD_FAST=0 to go back.
SD_FAST=1
SD_LCM_LORA=/home/akw/jetson-ai/models/images/fast/lcm-lora-sdv1-5.safetensors
SD_LCM_STEPS=6
SD_TAESD=/home/akw/jetson-ai/models/images/fast/taesd.safetensors
# An illustration is skipped (the story continues) when free memory is below this many MB.
SD_MIN_FREE_MB=2500

# ---------- Page backgrounds ----------
# Where each page's background picture comes from:
#   huggingface  painted in the cloud (needs HF_TOKEN in .env), no load on the Jetson
#   local        painted on the Jetson with sd-cli (settings above)
#   off          no pictures
# The child's hero drawing is layered on top of the background in the browser.
IMAGE_MODE=huggingface
HF_PROVIDER=nscale
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# A background that takes longer than this is given up on.
HF_TIMEOUT_SECONDS=20
# When Hugging Face fails, paint locally instead (only if memory allows, see SD_MIN_FREE_MB).
HF_FALLBACK_LOCAL=1

# ---------- The hero drawing (/draw) ----------
# Vision models that describe the child's drawing in one sentence, tried in order
# (through the Hugging Face router, with HF_TOKEN from .env).
VISION_MODELS=meta-llama/Llama-4-Scout-17B-16E-Instruct,google/gemma-3-27b-it
VISION_TIMEOUT_SECONDS=20

# ---------- Narration ----------
# elevenlabs = a natural voice from ElevenLabs (needs ELEVENLABS_API_KEY in .env, and
#              ELEVENLABS_VOICE_ID there to pick the voice). If it fails, takes longer than
#              ELEVENLABS_TIMEOUT_SECONDS or has no key, the browser's own voice reads instead.
# browser    = the browser's own voice.
# Other values: auto (Piper on the Jetson when installed, otherwise the browser), piper, off
TTS_MODE=elevenlabs
# The fastest ElevenLabs model. Each page is voiced once and kept in data/audio.
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_SECONDS=10
PIPER_BIN=/home/akw/jetson-ai/.venv/bin/piper
PIPER_VOICE=/home/akw/jetson-ai/models/voices/en_US-lessac-medium.onnx

# ---------- Voice input ----------
# The browser's speech recognition is used when it exists. Optional offline fallback:
# whisper.cpp on the Jetson (see README, "Offline voice input").
WHISPER_CLI=/home/akw/jetson-ai/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/akw/jetson-ai/whisper.cpp/models/ggml-base.en.bin

# ---------- LED strip ----------
# An ESP32 with 30 LEDs on USB (firmware/esp32_leds). Each page's background colours, top to
# bottom; a gentle glow when no story is open. Without the ESP32 nothing happens.
LED_ENABLED=true
LED_COUNT=30
# true when LED 0 is at the bottom instead of the top.
LED_REVERSE=false
# Brightest the strip ever gets (0.4 = 40%).
LED_BRIGHTNESS=0.4
# Leave empty to find the port by itself (/dev/ttyUSB* or /dev/ttyACM*).
LED_PORT=

# ---------- Web server ----------
HOST=0.0.0.0
PORT=8000
# Microphones only work on secure (https) pages. When certs/cert.pem exists
# (make it with ./scripts/make_cert.sh) the site is also served on this port over https.
HTTPS_PORT=8443
